@echo off\r\nsetlocal\r\ntitle M Commerce - Panel Maestro\r\necho.\r\necho  M COMMERCE - PANEL MAESTRO\r\necho  Instalando acceso directo de escritorio...\r\necho.\r\npowershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $url='https://m-commerce-ar.vercel.app/app-maestro/panel?desktop=1'; $candidates=@($env:ProgramFiles+'\\Microsoft\\Edge\\Application\\msedge.exe', ${env:ProgramFiles(x86)}+'\\Microsoft\\Edge\\Application\\msedge.exe', $env:ProgramFiles+'\\Google\\Chrome\\Application\\chrome.exe', ${env:ProgramFiles(x86)}+'\\Google\\Chrome\\Application\\chrome.exe'); $browser=$candidates | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1; if(-not $browser){ throw 'No se encontro Microsoft Edge ni Google Chrome.' }; $ws=New-Object -ComObject WScript.Shell; $desktop=[Environment]::GetFolderPath('Desktop'); $start=[Environment]::GetFolderPath('Programs'); foreach($path in @((Join-Path $desktop 'M Commerce - Panel Maestro.lnk'),(Join-Path $start 'M Commerce - Panel Maestro.lnk'))){ $s=$ws.CreateShortcut($path); $s.TargetPath=$browser; $s.Arguments='--app='+$url+' --start-maximized'; $s.WorkingDirectory=(Split-Path $browser); $s.IconLocation=$browser+',0'; $s.Description='M Commerce - Panel Maestro'; $s.Save() }; Start-Process -FilePath $browser -ArgumentList ('--app='+$url+' --start-maximized');"\r\nif errorlevel 1 (\r\n  echo.\r\n  echo No se pudo completar la instalacion.\r\n  echo Asegurate de tener Microsoft Edge o Google Chrome instalado.\r\n  pause\r\n  exit /b 1\r\n)\r\necho.\r\necho Instalacion completada.\r\necho Se creo M Commerce - Panel Maestro en el escritorio y en el menu Inicio.\r\ntimeout /t 3 >nul\r\nexit /b 0